{% extends 'base.html.twig' %}

{% block title %}Hello PartyGameController!{% endblock %}

{% block body %}
    <h1>Party Games Available</h1>
    {% for message in app.flashes('error') %}
        <p class="alert alert-danger">{{ message }}</p>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <p class="alert alert-success">{{ message }}</p>
    {% endfor %}

    {% if partyGames is empty %}
        <p>No board games found</p>
    {% else %}
        <ul class="party-game-list">
            {% for partyGame in partyGames %}
                <li>{{ partyGame.partyGameName }}</li>
                <form action="{{ path("app_booking", {'id': partyGame.id}) }}" method="POST">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('book_' ~ partyGame.id) }}">
                    <button type="submit">Book</button>
                    
                </form>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
