{% extends 'base.html.twig' %}

{% block title %}Hello BookingController!{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }
        .example-wrapper code {
            background: #f5f5f5;
            padding: 2px 6px;
        }
    </style>

    <div class="example-wrapper">
        <h1>Welcome on your booking page ! ✅</h1>
        {% if bookings is empty %}
            <p>No booking yet</p>
        {% else %}
            <ul>
                {% for booking in bookings %}
                    <li>{{ booking.partyGame.partyGameName }}</li>
                    <li>{{ booking.bookingDate|date('d-m-Y H:i') }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
